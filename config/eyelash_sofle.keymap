#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>


&soft_off { hold-time-ms = <2000>; };

/ {

    behaviors {
        // On UPPER, Ctrl + arrows/comma sends Rectangle's Ctrl + Option shortcuts.
        // Keeping Ctrl makes this work whichever modifier key is pressed first.
        rect_up: rectangle_up {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp UP>, <&kp LA(UP)>;
            mods = <MOD_LCTL>;
            keep-mods = <MOD_LCTL>;
        };

        rect_down: rectangle_down {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOWN>, <&kp LA(DOWN)>;
            mods = <MOD_LCTL>;
            keep-mods = <MOD_LCTL>;
        };

        rect_left: rectangle_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LEFT>, <&kp LA(LEFT)>;
            mods = <MOD_LCTL>;
            keep-mods = <MOD_LCTL>;
        };

        rect_right: rectangle_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RIGHT>, <&kp LA(RIGHT)>;
            mods = <MOD_LCTL>;
            keep-mods = <MOD_LCTL>;
        };

        rect_center: rectangle_center_half {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp INSERT>, <&kp LA(COMMA)>;
            mods = <MOD_LCTL>;
            keep-mods = <MOD_LCTL>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp ESC             &kp N1              &kp N2              &kp N3        &kp N4       &kp N5       &none       &kp N6          &kp N7     &kp N8           &kp N9           &kp N0      &kp BACKSPACE
&kp GRAVE           &kp Q               &kp W               &kp E         &kp R        &kp T        &none       &kp Y           &kp U      &kp I            &kp O            &kp P       &kp BSLH
&kp TAB             &kp A               &kp S               &kp D         &kp F        &kp G        &none       &kp H           &kp J      &kp K            &kp L            &kp SEMI    &kp APOS
&kp LEFT_CONTROL    &kp Z               &kp X               &kp C         &kp V        &kp B        &none       &kp N           &kp M      &kp COMMA        &kp DOT          &kp FSLH    &kp ENTER
&none               &kp LEFT_ALT        &kp LEFT_CONTROL    &kp LEFT_GUI  &kp SPACE    &mo 1        &mo 2       &mo 2           &kp RSHIFT &kp RIGHT_GUI    &kp RIGHT_SHIFT  &kp DELETE
            >;

            display-name = "HOME";
        };

        layer_1 {
            bindings = <
&kp GRAVE           &kp F1           &kp F2                 &kp F3           &kp F4           &kp F5             &none             &kp F6           &kp F7           &kp F8        &kp F9          &kp F12           &kp BACKSPACE 
&trans              &kp GRAVE        &kp F11                &kp F12          &none            &none              &none             &kp PG_UP        &kp END          &rect_up      &kp HOME        &kp MINUS         &kp EQUAL
&trans              &kp TILDE        &trans                 &trans           &trans           &none              &none             &kp PG_DN        &rect_left       &rect_down    &rect_right     &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp LEFT_CONTROL    &rgb_ug RGB_OFF  &rgb_ug RGB_ON         &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI    &none             &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rect_center  &none           &none             &trans
&none               &kp LEFT_ALT     &kp LEFT_CONTROL       &kp LEFT_GUI     &kp SPACE        &mo 1              &mo 2             &mo 2            &kp RSHIFT       &kp RIGHT_GUI &kp RIGHT_SHIFT &kp DELETE
            >;

            display-name = "UPPER";
        };

        layer_2 {
            bindings = <
&kp TILDE  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none     &kp F6  &kp F7  &kp F8      &kp F9     &kp F10      &trans
&trans     &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans          &none     &trans  &trans  &kp F11     &kp F12    &kp UNDER    &kp PLUS
&trans     &out OUT_USB  &out OUT_BLE    &trans        &trans        &trans          &none     &trans  &trans  &trans      &trans     &kp LBRC     &kp RBRC
&trans     &sys_reset    &trans          &bootloader   &trans        &trans          &none     &trans  &trans  &sys_reset  &soft_off  &bootloader  &trans
&trans     &trans        &trans          &trans        &trans        &trans          &none     &trans  &trans  &trans      &trans     &trans
            >;

            display-name = "LOWER";
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "layer3";
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
         display-name = "layer4";
        };
    };
};
